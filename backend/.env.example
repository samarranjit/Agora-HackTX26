# Settings for the backend (`uv run learning-game-api serve`).
# Copy to .env (git-ignored) and load it with:
#   uv run --env-file .env learning-game-api serve
# Never commit real values. In Docker, pass them with `docker run --env-file`.

# --- Game master ---------------------------------------------------------
# disabled (default): uploads and generation return HTTP 503.
# http:  a real game master service; GAME_MASTER_URL is required.
# fake:  FAKE multiplication questions that ignore the PDF. Demo/tests only.
GAME_MASTER_MODE=disabled
# GAME_MASTER_URL=https://game-master.internal.example
# GAME_MASTER_API_KEY=
# GAME_MASTER_TIMEOUT_SECONDS=60

# --- Storage ---------------------------------------------------------------
# Folder for the SQLite database and uploaded PDFs.
# Default: backend/var/ in a checkout, else ~/.learning-game/server.
# The Docker image sets this to /data (mount a durable volume there).
# LEARNING_GAME_DATA_DIR=

# --- Limits and sessions ---------------------------------------------------
# LEARNING_GAME_MAX_UPLOAD_BYTES=20971520
# LEARNING_GAME_SESSION_TTL_HOURS=168
# LEARNING_GAME_ALLOW_REGISTRATION=true

# --- Browser access and transport -------------------------------------------
# Comma-separated EXACT frontend origins allowed by CORS (scheme://host[:port], no
# path, no wildcard; `*` is rejected). Empty means no cross-origin access.
# LEARNING_GAME_CORS_ORIGINS=https://app.example.com
# Responses smaller than this are not gzip-compressed.
# LEARNING_GAME_GZIP_MINIMUM_BYTES=1000
